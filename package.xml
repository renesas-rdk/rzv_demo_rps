<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rzv_demo_rps</name>
  <version>0.1.0</version>
  <description>Demo game package for RZ/V platform with vision, hand control, and visualization </description>
  <maintainer email="dat.nguyen.dn@bp.renesas.com">Dat Nguyen</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 core dependencies -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>

  <!-- Message type dependencies -->
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>action_msgs</depend>

  <!-- External dependencies -->
  <depend>ament_index_cpp</depend>

  <!-- Vision and perception -->
  <exec_depend>rzv_object_detection</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>foxglove_keypoint_publisher</exec_depend>

  <!-- Hand control and visualization -->
  <exec_depend>arm_hand_control</exec_depend>
  
  <exec_depend>inspire_rh56_hand_bringup</exec_depend>
  <exec_depend>inspire_rh56_hand_description</exec_depend>
  <exec_depend>inspire_rh56_hand_ros2_control</exec_depend>

  <exec_depend>ruiyan_rh2_hand_bringup</exec_depend>
  <exec_depend>ruiyan_rh2_hand_description</exec_depend>
  <exec_depend>ruiyan_rh2_hand_ros2_control</exec_depend>

  <!-- Visualization bridge -->
  <exec_depend>foxglove_bridge</exec_depend>

  <!-- Launch infrastructure -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Testing dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>